{%- comment -%}
  Vulcan commercial product — main section.
  Live Trustpilot widget, title + blurb, gallery, Shipping/Installation/
  Warranty dropdowns, and the buy box (Zip, humm, Shop Pay, guarantees,
  Australian owned). Afterpay's message comes from the Afterpay app snippet
  in theme.liquid. Built for the District theme: the add-to-cart form is
  wrapped in District's <product-form> so it opens the theme's cart popup.
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = current_variant.featured_media | default: product.featured_media
  assign form_id = 'vcp-form-' | append: section.id

  # Titles in this store end with a stock status, e.g. "... | IN STOCK" or
  # "... | MADE-TO-ORDER 60~75 DAYS". Show the name in the H1 and move the
  # status into the photo badge.
  assign display_title = product.title
  assign title_status = ''
  if section.settings.split_title and product.title contains ' | '
    assign display_title = product.title | split: ' | ' | first
    assign title_status = product.title | split: ' | ' | last | strip
  endif

  assign variant_status = ''
  if section.settings.split_title and current_variant.title contains ' | '
    assign variant_status = current_variant.title | split: ' | ' | last | strip
  endif
  assign status_text = variant_status | default: title_status

  # Badge: green = in stock, orange = pre-order / made-to-order, grey = sold out
  assign status_upcase = status_text | upcase
  if current_variant.available == false
    assign stock_state = 'out'
    assign badge_text = section.settings.badge_out_text
  elsif section.settings.badge_mode == 'pre_order'
    assign stock_state = 'other'
    assign badge_text = section.settings.badge_preorder_text
  elsif section.settings.badge_mode == 'in_stock' or status_text == blank
    assign stock_state = 'in'
    assign badge_text = section.settings.badge_in_text
  elsif status_upcase contains 'IN STOCK'
    assign stock_state = 'in'
    assign badge_text = status_text
  else
    assign stock_state = 'other'
    assign badge_text = status_text
  endif

  assign price = current_variant.price
  assign compare_at = current_variant.compare_at_price | default: 0

  assign humm_payments = section.settings.humm_payments | default: 0
  assign humm_amount_html = ''
  if humm_payments > 0
    assign humm_amount = price | times: 1.0 | divided_by: humm_payments | ceil
    assign humm_amount_html = humm_amount | money | prepend: '<strong data-vcp-humm-amount>' | append: '</strong>'
  endif
  assign humm_text = section.settings.humm_text | escape | replace: '[amount]', humm_amount_html

  assign tab_blocks = section.blocks | where: 'type', 'tab'
  assign guarantee_blocks = section.blocks | where: 'type', 'guarantee'
-%}

{% render 'vulcan-commercial-assets' %}
<script src="{{ 'vulcan-commercial.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign font = section.settings.font
  assign font_500 = font | font_modify: 'weight', '500'
  assign font_600 = font | font_modify: 'weight', '600'
  assign font_700 = font | font_modify: 'weight', '700'
  assign font_800 = font | font_modify: 'weight', '800'
-%}
{% style %}
  {{ font | font_face: font_display: 'swap' }}
  {{ font_500 | font_face: font_display: 'swap' }}
  {{ font_600 | font_face: font_display: 'swap' }}
  {{ font_700 | font_face: font_display: 'swap' }}
  {{ font_800 | font_face: font_display: 'swap' }}
  .vcp {
    font-family: {{ font.family }}, {{ font.fallback_families }};
  }
{% endstyle %}

<div
  class="vcp vcp-product"
  data-vcp-product
  style="--vcp-stage-ratio: {{ section.settings.gallery_ratio }}; --vcp-stage-bg: {{ section.settings.gallery_bg }}; --vcp-badge-in: {{ section.settings.badge_in_color }}; --vcp-badge-pre: {{ section.settings.badge_preorder_color }};"
>
  {%- if section.settings.show_breadcrumb -%}
    <nav class="vcp-wrap vcp-crumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span aria-hidden="true">/</span>
      {%- if section.settings.breadcrumb_label != blank -%}
        <a href="{{ section.settings.breadcrumb_url | default: routes.all_products_collection_url }}">
          {{- section.settings.breadcrumb_label | escape -}}
        </a>
        <span aria-hidden="true">/</span>
      {%- elsif collection -%}
        <a href="{{ collection.url }}">{{ collection.title | escape }}</a>
        <span aria-hidden="true">/</span>
      {%- endif -%}
      <span aria-current="page">{{ display_title | escape }}</span>
    </nav>
  {%- endif -%}

  <div class="vcp-wrap vcp-main">
    <div class="vcp-main__top">
      {%- if section.settings.show_trustpilot -%}
        {%- liquid
          assign tp_score = section.settings.trustpilot_score | default: '5' | plus: 0
          # Trustpilot rounds the stars to the nearest half
          assign tp_stars = tp_score | times: 2 | round | divided_by: 2.0
          assign tp_url = section.settings.trustpilot_link | default: 'https://au.trustpilot.com/review/vulcanfitness.com.au'
          case section.settings.trustpilot_style
            when 'mini'
              assign tp_template = '53aa8807dec7e10d38f59f32'
              assign tp_height = '150px'
            when 'micro_trustscore'
              assign tp_template = '5419b637fa0340045cd0c936'
              assign tp_height = '20px'
            when 'micro_star'
              assign tp_template = '5419b732fbfb950b10de65e5'
              assign tp_height = '24px'
            else
              assign tp_template = ''
          endcase
        -%}
        {%- capture tp_static -%}
          <a class="vcp-tp" href="{{ tp_url }}" target="_blank" rel="noopener">
            <span class="vcp-tp__stars" role="img" aria-label="Rated {{ tp_score }} out of 5 on Trustpilot">
              {%- for i in (1..5) -%}
                {%- liquid
                  assign half_step = i | minus: 0.5
                  if tp_stars >= i
                    assign star_class = ''
                  elsif tp_stars >= half_step
                    assign star_class = ' vcp-tp__star--half'
                  else
                    assign star_class = ' vcp-tp__star--empty'
                  endif
                -%}
                <span class="vcp-tp__star{{ star_class }}">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="#ffffff" aria-hidden="true" focusable="false">
                    <path d="M12 2.5l2.9 6.3 6.9.7-5.2 4.6 1.5 6.8L12 17.4l-6.1 3.5 1.5-6.8L2.2 9.5l6.9-.7z"></path>
                  </svg>
                </span>
              {%- endfor -%}
            </span>
            <span class="vcp-tp__count">
              <strong>TrustScore {{ section.settings.trustpilot_score | escape }}</strong>
              | {{ section.settings.trustpilot_reviews | escape }} on Trustpilot
            </span>
          </a>
        {%- endcapture -%}
        {%- if tp_template != blank and section.settings.trustpilot_business_id != blank -%}
          {%- comment -%}
            Trustpilot's own widget — pulls the live TrustScore and review count.
            The strip inside shows until it loads (or if it can't).
          {%- endcomment -%}
          <div
            class="trustpilot-widget vcp-tp-live vcp-tp-live--{{ section.settings.trustpilot_style }}"
            data-locale="en-AU"
            data-template-id="{{ tp_template }}"
            data-businessunit-id="{{ section.settings.trustpilot_business_id | strip | escape }}"
            data-style-height="{{ tp_height }}"
            data-style-width="100%"
            data-theme="light"
            data-vcp-trustbox
          >
            {{ tp_static }}
          </div>
        {%- else -%}
          {{ tp_static }}
        {%- endif -%}
      {%- endif -%}

      <div class="vcp-heading">
        <h1 class="vcp-title">{{ display_title | escape }}</h1>
        {%- if section.settings.blurb != blank -%}
          <div class="vcp-blurb">{{ section.settings.blurb }}</div>
        {%- endif -%}
      </div>

      <div class="vcp-gallery" data-vcp-gallery>
        <div class="vcp-stage">
          {%- for media in product.media -%}
            {%- liquid
              assign is_active = false
              if media.id == featured_media.id
                assign is_active = true
              endif
              if is_active
                assign img_loading = 'eager'
              else
                assign img_loading = 'lazy'
              endif
              assign media_alt = media.alt | default: display_title
            -%}
            <div class="vcp-stage__item" data-vcp-media="{{ media.id }}" {% unless is_active %}hidden{% endunless %}>
              {%- case media.media_type -%}
                {%- when 'image' -%}
                  {{
                    media
                    | image_url: width: 1600
                    | image_tag:
                      loading: img_loading,
                      widths: '480, 720, 960, 1200, 1600',
                      sizes: '(min-width: 1280px) 744px, (min-width: 1000px) calc(100vw - 536px), calc(100vw - 32px)',
                      alt: media_alt
                  }}
                {%- when 'video' -%}
                  {{ media | video_tag: controls: true, image_size: '1600x' }}
                {%- when 'external_video' -%}
                  {{ media | external_video_tag }}
                {%- else -%}
                  {{ media.preview_image | image_url: width: 1600 | image_tag: loading: img_loading, alt: media_alt }}
              {%- endcase -%}
            </div>
          {%- else -%}
            <div class="vcp-stage__item">{{ 'product-1' | placeholder_svg_tag: 'vcp-placeholder' }}</div>
          {%- endfor -%}

          {%- if section.settings.show_badge -%}
            <span class="vcp-badge" data-vcp-badge data-state="{{ stock_state }}">{{ badge_text | escape }}</span>
          {%- endif -%}

          {%- if section.settings.show_consultant -%}
            <details class="vcp-consult" data-vcp-consult>
              <summary>
                {% render 'vulcan-commercial-icon', icon: 'chat', size: 18 %}
                {{ section.settings.consult_label | escape }}
                <span class="vcp-plus" aria-hidden="true">+</span>
              </summary>
              <div class="vcp-consult__panel">
                {%- if section.settings.consult_email != blank -%}
                  <a href="mailto:{{ section.settings.consult_email | strip }}">
                    {% render 'vulcan-commercial-icon', icon: 'mail', size: 18 %}
                    <span>
                      <strong>Email us</strong>
                      <span class="vcp-consult__sub">{{ section.settings.consult_email | escape }}</span>
                    </span>
                  </a>
                {%- endif -%}
                {%- if section.settings.consult_phone != blank -%}
                  <a href="tel:{{ section.settings.consult_phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}">
                    {% render 'vulcan-commercial-icon', icon: 'phone', size: 18 %}
                    <span>
                      <strong>Call us</strong>
                      <span class="vcp-consult__sub">{{ section.settings.consult_phone | escape }}</span>
                    </span>
                  </a>
                {%- endif -%}
              </div>
            </details>
          {%- endif -%}
        </div>

        {%- if product.media.size > 1 -%}
          <div class="vcp-thumbs">
            {%- for media in product.media -%}
              <button
                type="button"
                class="vcp-thumb"
                data-vcp-thumb="{{ media.id }}"
                aria-label="Show image {{ forloop.index }} of {{ forloop.length }}"
                aria-current="{% if media.id == featured_media.id %}true{% else %}false{% endif %}"
              >
                {{ media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', widths: '100, 200', sizes: '100px', alt: '' }}
                {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
                  <span class="vcp-thumb__play" aria-hidden="true">&#9654;</span>
                {%- endif -%}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- if tab_blocks.size > 0 -%}
      <div class="vcp-main__bottom">
        <div class="vcp-tabs" style="--vcp-tab-count: {{ tab_blocks.size }};">
          {%- for block in tab_blocks -%}
            <button
              type="button"
              class="vcp-tab"
              id="vcp-tab-{{ block.id }}"
              aria-expanded="false"
              aria-controls="vcp-tab-panel-{{ block.id }}"
              data-vcp-tab
              {{ block.shopify_attributes }}
            >
              <span class="vcp-tab__label">
                {%- if block.settings.icon != 'none' -%}
                  <span class="vcp-tab__icon">{% render 'vulcan-commercial-icon', icon: block.settings.icon, size: 19 %}</span>
                {%- endif -%}
                {{ block.settings.title | escape }}
              </span>
              <span class="vcp-plus" aria-hidden="true">+</span>
            </button>
            <div
              class="vcp-tab-panel vcp-rte"
              id="vcp-tab-panel-{{ block.id }}"
              role="region"
              aria-labelledby="vcp-tab-{{ block.id }}"
              hidden
            >
              {{ block.settings.content }}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    <aside class="vcp-buybox" aria-label="Purchase options">
      <div class="vcp-price">
        <span class="vcp-price__now" data-vcp-price>{{ price | money }}</span>
        <s class="vcp-price__was" data-vcp-compare {% unless compare_at > price %}hidden{% endunless %}>
          {{- compare_at | money -}}
        </s>
      </div>
      {%- if section.settings.price_note != blank -%}
        <div class="vcp-price-note">{{ section.settings.price_note }}</div>
      {%- endif -%}

      {%- unless product.has_only_default_variant -%}
        <div class="vcp-variant">
          <label for="vcp-variant-{{ section.id }}">{{ product.options | join: ' / ' | escape }}</label>
          <select id="vcp-variant-{{ section.id }}" data-vcp-variant-select>
            {%- for variant in product.variants -%}
              <option value="{{ variant.id }}" {% if variant.id == current_variant.id %}selected{% endif %}>
                {{- variant.title | escape -}}
                {%- unless variant.available %} — {{ section.settings.sold_out_label | escape }}{% endunless -%}
              </option>
            {%- endfor -%}
          </select>
        </div>
      {%- endunless -%}

      {%- if section.settings.show_zip or section.settings.show_humm -%}
        <div class="vcp-bnpl">
          {%- if section.settings.show_zip -%}
            <div class="vcp-bnpl__row">
              <span class="vcp-bnpl__text">{{ section.settings.zip_text | escape }}</span>
              <a
                class="vcp-pill vcp-pill--zip"
                href="https://zip.co/au"
                target="_blank"
                rel="noopener"
                aria-label="Zip (opens in a new tab)"
              >
                Zip
              </a>
            </div>
          {%- endif -%}

          {%- if section.settings.show_humm -%}
            <div class="vcp-bnpl__row">
              {%- if section.settings.humm_mode == 'widget' and section.settings.humm_merchant_id != blank -%}
                {%- comment -%}
                  humm's own price widget — the same script your District product pages use.
                  It writes its message where the script tag sits, so it has to load inline.
                {%- endcomment -%}
                <div class="vcp-humm-widget">
                  {% # theme-check-disable ParserBlockingScript, RemoteAsset %}
                  <script src="https://bpi.humm-au.com/au/content/scripts/price-info_sync.js?productPrice={{ price | divided_by: 100.0 }}&merchantId={{ section.settings.humm_merchant_id | strip | url_encode }}"></script>
                  {% # theme-check-enable ParserBlockingScript, RemoteAsset %}
                </div>
              {%- else -%}
                <span class="vcp-bnpl__text" data-vcp-humm-text>{{ humm_text }}</span>
                <a
                  class="vcp-pill vcp-pill--humm"
                  href="https://www.shophumm.com/au/"
                  target="_blank"
                  rel="noopener"
                  aria-label="humm (opens in a new tab)"
                >
                  humm
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            <div class="vcp-app-block">{% render block %}</div>
          {%- when 'liquid' -%}
            <div class="vcp-custom-liquid" {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
        {%- endcase -%}
      {%- endfor -%}

      <product-form class="vcp-form">
        <div class="product-form__error-container vcp-form__error" role="alert" hidden>
          <span class="product-form__error-message"></span>
        </div>
        {%- form 'product', product, id: form_id, class: 'vcp-form__form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-vcp-variant-id>
          <div class="vcp-buy">
            <div class="vcp-qty">
              <button type="button" class="vcp-qty__btn" data-vcp-qty-step="-1" aria-label="Decrease quantity">&minus;</button>
              <label class="vcp-visually-hidden" for="vcp-qty-{{ section.id }}">Quantity</label>
              <input
                class="vcp-qty__input"
                id="vcp-qty-{{ section.id }}"
                type="number"
                name="quantity"
                value="1"
                min="1"
                max="99"
                inputmode="numeric"
                data-vcp-qty
              >
              <button type="button" class="vcp-qty__btn" data-vcp-qty-step="1" aria-label="Increase quantity">+</button>
            </div>
            <button
              type="submit"
              name="add"
              class="vcp-atc"
              data-vcp-atc
              {% unless current_variant.available %}
                disabled
              {% endunless %}
            >
              <span data-vcp-atc-label>
                {%- if current_variant.available -%}
                  {{ section.settings.atc_label | escape }}
                {%- else -%}
                  {{ section.settings.sold_out_label | escape }}
                {%- endif -%}
              </span>
            </button>
          </div>
          {%- if section.settings.show_dynamic_checkout -%}
            <div class="vcp-dynamic-checkout">{{ form | payment_button }}</div>
          {%- endif -%}
        {%- endform -%}
      </product-form>

      {%- if guarantee_blocks.size > 0 -%}
        <div class="vcp-guarantees">
          {%- for block in guarantee_blocks -%}
            <details class="vcp-guarantee" {{ block.shopify_attributes }}>
              <summary>
                <span class="vcp-guarantee__icon">{% render 'vulcan-commercial-icon', icon: block.settings.icon %}</span>
                <span class="vcp-guarantee__text">
                  <strong>{{ block.settings.title | escape }}</strong>
                  {%- if block.settings.subtitle != blank -%}
                    <span class="vcp-guarantee__sub">{{ block.settings.subtitle | escape }}</span>
                  {%- endif -%}
                </span>
                <span class="vcp-plus" aria-hidden="true">+</span>
              </summary>
              <div class="vcp-guarantee__body vcp-rte">{{ block.settings.content }}</div>
            </details>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_au_owned -%}
        <div class="vcp-au">
          {%- if section.settings.au_badge != blank -%}
            {{
              section.settings.au_badge
              | image_url: width: 240
              | image_tag: width: 80, height: 80, loading: 'lazy', class: 'vcp-au__badge'
            }}
          {%- else -%}
            <img
              class="vcp-au__badge"
              src="{{ 'vulcan-australian-owned.webp' | asset_url }}"
              alt="Australian Owned Certified badge #08375"
              width="80"
              height="80"
              loading="lazy"
            >
          {%- endif -%}
          <div>
            <p class="vcp-au__title">{{ section.settings.au_heading | escape }}</p>
            {%- if section.settings.au_text != blank -%}
              <div class="vcp-au__text">{{ section.settings.au_text }}</div>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </aside>
  </div>

  <script type="application/json" data-vcp-config>
    {
      "moneyFormat": {{ shop.money_format | json }},
      "splitTitle": {{ section.settings.split_title | json }},
      "productStatus": {{ title_status | json }},
      "badgeMode": {{ section.settings.badge_mode | json }},
      "badgeIn": {{ section.settings.badge_in_text | json }},
      "badgePre": {{ section.settings.badge_preorder_text | json }},
      "badgeOut": {{ section.settings.badge_out_text | json }},
      "atcLabel": {{ section.settings.atc_label | json }},
      "soldOutLabel": {{ section.settings.sold_out_label | json }},
      "hummPayments": {{ humm_payments | json }},
      "variants": {{ product.variants | json }}
    }
  </script>
</div>

{% schema %}
{
  "name": "Commercial product",
  "tag": "section",
  "class": "vcp-section vcp-section--product",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Title & blurb"
    },
    {
      "type": "checkbox",
      "id": "split_title",
      "label": "Move stock status out of the title",
      "info": "Your product titles end with “| IN STOCK”, “| PRE-ORDER …” etc. When on, that part is hidden from the heading and shown in the photo badge and stock line instead.",
      "default": true
    },
    {
      "type": "richtext",
      "id": "blurb",
      "label": "Blurb under the title",
      "info": "One or two sentences on why it's good. Connect it to a product metafield to write a different blurb per product.",
      "default": "<p>Dual-function quad and hamstring station built for floors that never get a day off.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Show breadcrumb",
      "default": true
    },
    {
      "type": "text",
      "id": "breadcrumb_label",
      "label": "Breadcrumb middle link",
      "default": "Commercial"
    },
    {
      "type": "url",
      "id": "breadcrumb_url",
      "label": "Breadcrumb middle link URL"
    },
    {
      "type": "font_picker",
      "id": "font",
      "label": "Page font",
      "info": "Archivo matches the design. Pick your District body font to blend in with the rest of the site.",
      "default": "archivo_n4"
    },
    {
      "type": "header",
      "content": "Trustpilot"
    },
    {
      "type": "checkbox",
      "id": "show_trustpilot",
      "label": "Show Trustpilot strip",
      "default": true
    },
    {
      "type": "select",
      "id": "trustpilot_style",
      "label": "Trustpilot widget",
      "options": [
        { "value": "mini", "label": "Mini — stars, TrustScore & review count (live)" },
        { "value": "micro_trustscore", "label": "Micro TrustScore — one line (live)" },
        { "value": "micro_star", "label": "Micro Star — one line (live)" },
        { "value": "static", "label": "Strip with the numbers below (not live)" }
      ],
      "default": "mini",
      "info": "The live widgets are Trustpilot's own and update by themselves."
    },
    {
      "type": "text",
      "id": "trustpilot_business_id",
      "label": "Trustpilot business ID",
      "default": "6022a7fcf1069f000155785b"
    },
    {
      "type": "text",
      "id": "trustpilot_score",
      "label": "TrustScore",
      "info": "Shown in the strip, and while the live widget loads.",
      "default": "4.9"
    },
    {
      "type": "text",
      "id": "trustpilot_reviews",
      "label": "Review count text",
      "default": "763 reviews"
    },
    {
      "type": "text",
      "id": "trustpilot_link",
      "label": "Trustpilot page link",
      "default": "https://au.trustpilot.com/review/vulcanfitness.com.au"
    },
    {
      "type": "header",
      "content": "Photos"
    },
    {
      "type": "select",
      "id": "gallery_ratio",
      "label": "Main photo shape",
      "options": [
