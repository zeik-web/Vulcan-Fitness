{%- comment -%}
  Vulcan commercial product — dimensions photos and specification rows.
  Front and side view drawings with arrows (and swipe) to switch between them.
{%- endcomment -%}

{%- liquid
  assign view_keys = 'image,image_side' | split: ','
  assign view_count = 0
  for key in view_keys
    if section.settings[key] != blank
      assign view_count = view_count | plus: 1
    endif
  endfor

  assign show_media = false
  if view_count > 0 or request.design_mode
    assign show_media = true
  endif
-%}

{% render 'vulcan-commercial-assets' %}
<script src="{{ 'vulcan-commercial.js' | asset_url }}" defer="defer"></script>
<div
  class="vcp vcp-dims"
  id="dimensions"
  style="--vcp-dims-bg: {{ section.settings.image_bg }}; --vcp-dims-fit: {{ section.settings.image_fit }};"
>
  <div class="vcp-wrap vcp-dims__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="vcp-h2">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <div class="vcp-dims__grid{% if show_media %} vcp-dims__grid--media{% endif %}">
      {%- if show_media -%}
        <div class="vcp-dims__media" data-vcp-views>
          {%- assign shown = 0 -%}
          {%- for key in view_keys -%}
            {%- assign image = section.settings[key] -%}
            {%- if image != blank -%}
              {%- assign label_key = key | append: '_label' -%}
              <figure class="vcp-dims__view" data-vcp-view {% if shown > 0 %}hidden{% endif %}>
                {{
                  image
                  | image_url: width: 1400
                  | image_tag:
                    loading: 'lazy',
                    widths: '600, 900, 1200, 1400',
                    sizes: '(min-width: 990px) 600px, calc(100vw - 32px)',
                    alt: section.settings[label_key]
                }}
              </figure>
              {%- assign shown = shown | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}

          {%- if view_count == 0 -%}
            {{ 'image' | placeholder_svg_tag: 'vcp-placeholder' }}
          {%- endif -%}

          {%- if view_count > 1 -%}
            <button type="button" class="vcp-dims__arrow vcp-dims__arrow--prev" data-vcp-view-step="-1" aria-label="Previous view">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 18l-6-6 6-6"></path></svg>
            </button>
            <button type="button" class="vcp-dims__arrow vcp-dims__arrow--next" data-vcp-view-step="1" aria-label="Next view">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 18l6-6-6-6"></path></svg>
            </button>
            <div class="vcp-dims__switch" role="group" aria-label="Dimension views">
              {%- assign shown = 0 -%}
              {%- for key in view_keys -%}
                {%- if section.settings[key] != blank -%}
                  {%- assign label_key = key | append: '_label' -%}
                  <button
                    type="button"
                    class="vcp-dims__tab"
                    data-vcp-view-go
                    aria-pressed="{% if shown == 0 %}true{% else %}false{% endif %}"
                  >
                    {{- section.settings[label_key] | escape -}}
                  </button>
                  {%- assign shown = shown | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <dl class="vcp-specs">
          {%- for block in section.blocks -%}
            <div class="vcp-specs__row" {{ block.shopify_attributes }}>
              <dt>{{ block.settings.label | escape }}</dt>
              <dd>{{ block.settings.value | escape }}</dd>
            </div>
          {%- endfor -%}
        </dl>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Commercial specs",
  "tag": "section",
  "class": "vcp-section vcp-section--dims",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Dimensions & specifications"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Front view photo",
      "info": "Square images work best. Add both views to show arrows for switching between them. Leave both empty to show the specs full width."
    },
    {
      "type": "text",
      "id": "image_label",
      "label": "Front view label",
      "default": "Front view"
    },
    {
      "type": "image_picker",
      "id": "image_side",
      "label": "Side view photo"
    },
    {
      "type": "text",
      "id": "image_side_label",
      "label": "Side view label",
      "default": "Side view"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Photo fit",
      "options": [
        { "value": "contain", "label": "Show whole photo" },
        { "value": "cover", "label": "Fill the square" }
      ],
      "default": "contain"
    },
    {
      "type": "color",
      "id": "image_bg",
      "label": "Photo background",
      "default": "#17171b"
    }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Spec row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Weight stack"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "[X] kg"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Commercial specs",
      "blocks": [
        { "type": "spec", "settings": { "label": "Weight stack", "value": "[X] kg" } },
        { "type": "spec", "settings": { "label": "Weight stack ratio", "value": "[X:X]" } },
        { "type": "spec", "settings": { "label": "Steel thickness", "value": "[X] mm" } },
        { "type": "spec", "settings": { "label": "Colour", "value": "[Frame colour]" } },
        { "type": "spec", "settings": { "label": "Upholstery", "value": "[Colour / material]" } },
        { "type": "spec", "settings": { "label": "Adjustable settings", "value": "[Back pad, shin pad, ROM]" } },
        { "type": "spec", "settings": { "label": "Dimensions", "value": "L [X] × W [X] × H [X] cm" } }
      ]
    }
  ]
}
{% endschema %}
